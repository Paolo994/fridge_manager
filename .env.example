# Copia questo file in .env e compila i valori. Il file .env non va committato.

# Segreto per firmare i token di login (almeno 32 caratteri casuali)
JWT_SECRET=

# Chiave API da console.anthropic.com (facoltativa: senza, le funzioni IA sono disattivate)
ANTHROPIC_API_KEY=
# Modello: claude-haiku-5-5 (economico, consigliato), claude-sonnet-5-5, claude-opus-5-5 (default)
ANTHROPIC_MODEL=claude-haiku-5-5

# DB_PASSWORD=fridge
# APP_PORT=3000
